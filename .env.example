# Copy to .env.local (not committed) and fill in real values.

# Used by src/app/sitemap.ts and src/app/robots.ts to build absolute URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain-or-vercel-url.vercel.app

# --- Admin panel (/admin) — product & content editing -----------------
# See README.md ("Admin panel & content editing") for the full setup guide.

# Supabase project connection (Settings -> API in your Supabase project).
# Server-only — never exposed to the browser. SUPABASE_SERVICE_ROLE_KEY is
# a powerful key: keep it out of git and out of any NEXT_PUBLIC_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single shared password for logging in at /admin. Choose a strong,
# unique value — anyone with it can edit every product and page on the site.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too
