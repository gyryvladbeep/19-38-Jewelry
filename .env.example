# Copy to .env.local (not committed) and fill in real values.

# Used by src/app/sitemap.ts and src/app/robots.ts to build absolute URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain-or-vercel-url.vercel.app

# --- Admin panel (/admin) — product & content editing -----------------
# See README.md ("Admin panel & content editing") for the full setup guide.

# Supabase project connection (Settings -> API in your Supabase project).
# Server-only — never exposed to the browser. SUPABASE_SERVICE_ROLE_KEY is
# a powerful key: keep it out of git and out of any NEXT_PUBLIC_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single shared password for logging in at /admin. Choose a strong,
# unique value — anyone with it can edit every product and page on the site.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too

# --- Order/contact email notifications ---------------------------------
# See README.md ("Подключение реальных уведомлений о заказах/сообщениях")
# for the full setup guide. Optional: without these, order requests and
# contact messages still work, they just aren't emailed anywhere (only
# logged server-side).

# The Gmail account that sends the notification (1938jewshop@gmail.com).
GMAIL_USER=1938jewshop@gmail.com
# An App Password generated FROM THAT ACCOUNT — not its normal login
# password. Requires 2-Step Verification to be turned on first:
# https://myaccount.google.com/security -> 2-Step Verification -> App
# passwords. Never commit the real value.
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where notifications are sent. Optional — defaults to GMAIL_USER itself.
SHOP_NOTIFICATION_EMAIL=1938jewshop@gmail.com
